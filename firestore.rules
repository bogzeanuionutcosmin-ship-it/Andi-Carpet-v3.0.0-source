rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return get(userPath()).data;
    }

    function isActive() {
      return signedIn()
        && exists(userPath())
        && userData().active == true;
    }

    function isAdmin() {
      return isActive()
        && userData().role == 'admin';
    }

    // Drepturile efective sunt calculate de aplicație din toate funcțiile atribuite
    // și sunt scrise doar de Admin în users/{uid}. Fallback-ul păstrează compatibilitatea
    // cu utilizatorii existenți până la prima sincronizare făcută de un Admin.
    function functionPath(functionId) {
      return /databases/$(database)/documents/functions/$(functionId);
    }

    function hasLegacyPermission(permission) {
      return isActive() && (
        userData().function == 'director'
        || (('function' in userData())
          && exists(functionPath(userData().function))
          && get(functionPath(userData().function)).data.active == true
          && permission in get(functionPath(userData().function)).data.permissions)
        || (userData().function == 'driver' && permission in [
          'viewDashboard', 'viewProgram', 'editProgram', 'viewMap',
          'viewCentralizer', 'viewOwnDecont', 'viewContacts'
        ])
        || (userData().function == 'worker' && permission in [
          'viewDashboard', 'viewProgram', 'editProgram', 'viewMap',
          'viewCentralizer', 'viewOwnDecont', 'viewContacts'
        ])
        || (userData().function == 'developer' && permission in [
          'viewDashboard', 'viewProgram', 'viewMap',
          'viewCentralizer', 'viewOwnDecont', 'viewContacts'
        ])
      );
    }

    function hasPermission(permission) {
      return isAdmin()
        || (isActive()
          && ('effectivePermissions' in userData())
          && userData().effectivePermissions is list
          && permission in userData().effectivePermissions)
        || (isActive()
          && !('effectivePermissions' in userData())
          && hasLegacyPermission(permission));
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function isTeamMember(teamId) {
      return isActive()
        && exists(teamPath(teamId))
        && request.auth.uid in get(teamPath(teamId)).data.members;
    }

    function otherUserPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function canNotifyUser(userId) {
      return isAdmin()
        || (isActive() && request.auth.uid == userId)
        || (isActive()
          && exists(otherUserPath(userId))
          && get(otherUserPath(userId)).data.active == true);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'member'
        && request.resource.data.active == false
        && request.resource.data.status == 'pending';

      allow update: if isAdmin() || (isActive()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'nickname', 'useNickname', 'username', 'usernameNormalized', 'phone', 'phoneNormalized', 'city', 'county', 'address', 'photoBase64', 'profileFields',
          'hireDate', 'contractFunction', 'theme', 'backgroundId', 'fontFamily', 'locationMode', 'locationIntervalMinutes', 'notificationPreferences', 'lastGroupChatSeenAt', 'hiddenFromMembers', 'updatedAt'
        ]));
      allow delete: if isAdmin();
    }

    // Director minimal publicat exclusiv de backend; niciun client nu poate scrie aici.
    // Profilurile private users/{uid} sunt accesibile doar proprietarului si Adminului.
    match /memberDirectory/{userId} {
      allow get, list: if isActive();
      allow create, update, delete: if false;
    }

    match /locations/{locationId} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (hasPermission('editContacts')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'contacts', 'phone', 'updatedAt'
          ]));
    }

    match /locationCategories/{categoryId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Fundaluri încărcate de Admin. Utilizatorii activi le pot citi, dar numai
    // Adminul le poate crea/modifica/șterge și selecta global din uiSettings.
    match /backgrounds/{backgroundId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /functions/{functionId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /cars/{carId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Graficul este vizibil intern, dar modificarea lui cere explicit dreptul editProgram.
    match /schedules/{scheduleId} {
      allow read: if isActive();
      allow create: if isAdmin()
        || (hasPermission('editProgram') && isTeamMember(request.resource.data.teamId));
      allow update: if isAdmin()
        || (hasPermission('editProgram')
          && isTeamMember(resource.data.teamId)
          && isTeamMember(request.resource.data.teamId));
      allow delete: if isAdmin()
        || (hasPermission('editProgram') && isTeamMember(resource.data.teamId));
    }

    // START/FINAL cer editProgram; corecțiile din Centralizator pot folosi editCentralizer.
    match /records/{recordId} {
      allow read: if isActive();
      allow create: if isAdmin()
        || ((hasPermission('editProgram') || hasPermission('editCentralizer'))
          && isTeamMember(request.resource.data.teamId));
      allow update: if isAdmin()
        || ((hasPermission('editProgram') || hasPermission('editCentralizer'))
          && isTeamMember(resource.data.teamId)
          && isTeamMember(request.resource.data.teamId));
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin()
        || hasPermission('viewOtherDecont')
        || isTeamMember(resource.data.teamId);
      allow create: if (isAdmin()
        || (hasPermission('viewOwnDecont') && isTeamMember(request.resource.data.teamId)
          && request.resource.data.distributedBy == request.auth.uid))
        && (!('supplementaryFor' in request.resource.data)
          || request.resource.data.supplementaryFor == null
          || (request.resource.data.supplementaryFor is string
            && exists(/databases/$(database)/documents/perDiems/$(request.resource.data.supplementaryFor))
            && get(/databases/$(database)/documents/perDiems/$(request.resource.data.supplementaryFor)).data.memberId == request.resource.data.memberId
            && get(/databases/$(database)/documents/perDiems/$(request.resource.data.supplementaryFor)).data.distributedBy == request.resource.data.distributedBy
            && get(/databases/$(database)/documents/perDiems/$(request.resource.data.supplementaryFor)).data.status == 'confirmed'));
      allow update: if isAdmin()
        || (hasPermission('viewOwnDecont')
          && isTeamMember(resource.data.teamId)
          && isTeamMember(request.resource.data.teamId));
      allow delete: if isAdmin();
    }

    // Registrul financiar v2: acces numai participanților; fără ștergere.
    // Aceste reguli nu înlocuiesc autorizarea pe server pentru compensări
    // sau soluționarea contestațiilor. Nu activați fluxul v2 în producție
    // înainte de testele emulatorului.
    match /per_diem_settlements_v2/{settlementId} {
      function settlementPath() {
        return /databases/$(database)/documents/per_diem_settlements_v2/$(settlementId);
      }
      function validMoney(n, zeroAllowed) {
        return n is int && n <= 100000000 &&
          (zeroAllowed ? n >= 0 : n > 0);
      }
      function validBase(d) {
        return d.distributorId is string && d.beneficiaryId is string
          && d.distributorId != d.beneficiaryId
          && validMoney(d.declaredBani, false);
      }
      function nextAudit() {
        return getAfter(/databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)/audit/$(('revision-' + string(request.resource.data.revision)))).data;
      }
      function hasMatchingAudit(action) {
        let auditPath = /databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)/audit/$(('revision-' + string(request.resource.data.revision)));
        return !exists(auditPath) && existsAfter(auditPath)
          && getAfter(auditPath).data.action == action
          && getAfter(auditPath).data.actorId == request.auth.uid
          && getAfter(auditPath).data.revision == request.resource.data.revision;
      }
      function validConfirmation() {
        let d = request.resource.data;
        let old = resource.data;
        return isActive() && request.auth.uid == old.beneficiaryId
          && validBase(old)
          && old.status in ['pending', 'refused']
          && d.diff(old).affectedKeys().hasOnly([
            'receivedBani', 'status', 'revision', 'updatedAt'
          ])
          && validMoney(d.receivedBani, true)
          && d.receivedBani <= old.declaredBani
          && d.status == (d.receivedBani == 0 ? 'refused' :
            (d.receivedBani == old.declaredBani ? 'received' : 'partiallyReceived'))
          && old.revision is int && old.revision >= 0
          && d.revision == old.revision + 1
          && d.updatedAt == request.time
          && hasMatchingAudit(d.receivedBani == 0 ? 'refuse' : 'acknowledge');
      }
      function validDispute() {
        let d = request.resource.data;
        let old = resource.data;
        return isActive() && request.auth.uid == old.distributorId
          && validBase(old)
          && old.status in ['refused', 'partiallyReceived']
          && d.diff(old).affectedKeys().hasOnly([
            'status', 'disputeReason', 'revision', 'updatedAt'
          ])
          && d.status == 'disputed'
          && d.disputeReason is string
          && d.disputeReason.size() > 0 && d.disputeReason.size() <= 1000
          && old.revision is int && old.revision >= 0
          && d.revision == old.revision + 1
          && d.updatedAt == request.time
          && hasMatchingAudit('dispute');
      }
      allow read: if isAdmin() || (isActive() &&
        (resource.data.distributorId == request.auth.uid ||
         resource.data.beneficiaryId == request.auth.uid));
      allow create: if isActive()
        && request.resource.data.keys().hasOnly([
          'distributorId', 'beneficiaryId', 'declaredBani', 'receivedBani',
          'status', 'paymentMethod', 'createdAt', 'updatedAt', 'revision'
        ])
        && request.resource.data.keys().hasAll([
          'distributorId', 'beneficiaryId', 'declaredBani', 'receivedBani',
          'status', 'paymentMethod', 'createdAt', 'updatedAt', 'revision'
        ])
        && validBase(request.resource.data)
        && request.auth.uid == request.resource.data.distributorId
        && request.resource.data.receivedBani == null
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod in ['cash', 'transfer']
        && request.resource.data.revision == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)/audit/declare)
        && existsAfter(/databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)/audit/declare)
        && getAfter(/databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)/audit/declare).data.actorId == request.auth.uid;
      allow update: if validConfirmation() || validDispute();
      allow delete: if false;
      match /audit/{auditId} {
        function parentAfter() {
          return getAfter(/databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)).data;
        }
        allow read: if isAdmin() || (isActive() &&
          (get(/databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)).data.distributorId == request.auth.uid ||
           get(/databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)).data.beneficiaryId == request.auth.uid));
        allow create: if isActive()
          && !exists(/databases/$(database)/documents/per_diem_settlements_v2/$(settlementId)/audit/$(auditId))
          && request.resource.data.at == request.time
          && request.resource.data.actorId == request.auth.uid
          && (
            (auditId == 'declare'
              && request.resource.data.keys().hasOnly([
                'action', 'actorId', 'amountBani', 'previousStatus',
                'newStatus', 'revision', 'at'
              ])
              && request.resource.data.action == 'declare'
              && request.resource.data.revision == 0
              && request.resource.data.previousStatus == null
              && request.resource.data.newStatus == 'pending'
              && parentAfter().distributorId == request.auth.uid
              && parentAfter().declaredBani == request.resource.data.amountBani
              && parentAfter().revision == 0
              && parentAfter().status == 'pending')
            ||
            (auditId == 'revision-' + string(request.resource.data.revision)
              && request.resource.data.revision is int
              && request.resource.data.revision > 0
              && parentAfter().revision == request.resource.data.revision
              && (
                (request.resource.data.action in ['acknowledge', 'refuse']
                  && request.resource.data.keys().hasOnly([
                    'action', 'actorId', 'receivedBani', 'previousReceivedBani',
                    'previousStatus', 'newStatus', 'revision', 'at'
                  ])
                  && parentAfter().beneficiaryId == request.auth.uid
                  && parentAfter().receivedBani == request.resource.data.receivedBani
                  && parentAfter().status == request.resource.data.newStatus
                  && request.resource.data.action == (request.resource.data.receivedBani == 0 ? 'refuse' : 'acknowledge'))
                ||
                (request.resource.data.action == 'dispute'
                  && request.resource.data.keys().hasOnly([
                    'action', 'actorId', 'reason', 'previousStatus',
                    'newStatus', 'revision', 'at'
                  ])
                  && parentAfter().distributorId == request.auth.uid
                  && parentAfter().status == 'disputed'
                  && parentAfter().disputeReason == request.resource.data.reason
                  && request.resource.data.newStatus == 'disputed')
              )
            )
          );
        allow update, delete: if false;
      }
    }

    match /perDiemDisputes/{perDiemId} {
      function original() {
        return get(/databases/$(database)/documents/perDiems/$(perDiemId)).data;
      }
      allow read: if isAdmin() || (isActive() && (
        resource.data.beneficiaryId == request.auth.uid ||
        resource.data.distributorId == request.auth.uid));
      allow create: if isActive()
        && exists(/databases/$(database)/documents/perDiems/$(perDiemId))
        && original().distributedBy == request.auth.uid
        && original().memberId != request.auth.uid
        && original().status == 'confirmed'
        && original().actualReceivedAmount is number
        && request.resource.data.keys().hasOnly([
          'perDiemId','distributorId','beneficiaryId','declaredBani',
          'receivedBani','status','reason','actorUid','createdAt'])
        && request.resource.data.perDiemId == perDiemId
        && request.resource.data.distributorId == request.auth.uid
        && request.resource.data.beneficiaryId == original().memberId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.declaredBani == int(original().amount * 100)
        && request.resource.data.receivedBani == int(original().actualReceivedAmount * 100)
        && request.resource.data.status in ['accepted','disputed']
        && request.resource.data.reason is string
        && (request.resource.data.status == 'accepted' || request.resource.data.reason.size() > 0);
      allow update: if isAdmin()
        && resource.data.status == 'disputed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','resolvedBy','resolvedAt'])
        && request.resource.data.status in ['resolved_accepted','resolved_rejected']
        && request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if false;
    }

    match /perDiems/{perDiemId}/receiptAudit/{auditId} {
      allow read: if isAdmin() || (isActive() &&
        (get(/databases/$(database)/documents/perDiems/$(perDiemId)).data.memberId == request.auth.uid ||
         get(/databases/$(database)/documents/perDiems/$(perDiemId)).data.distributedBy == request.auth.uid));
      allow create: if isActive() &&
        get(/databases/$(database)/documents/perDiems/$(perDiemId)).data.memberId == request.auth.uid &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.beneficiaryId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['actorUid','action','distributorId','beneficiaryId','declaredAmountBani','actualReceivedBani','differenceBani','createdAt']) &&
        request.resource.data.action in ['reported_missing','confirmed_received']
        && request.resource.data.declaredAmountBani == int(get(/databases/$(database)/documents/perDiems/$(perDiemId)).data.amount * 100)
        && getAfter(/databases/$(database)/documents/perDiems/$(perDiemId)).data.receiptUpdatedAt == request.resource.data.createdAt
        && getAfter(/databases/$(database)/documents/perDiems/$(perDiemId)).data.memberId == request.auth.uid
        && getAfter(/databases/$(database)/documents/perDiems/$(perDiemId)).data.distributedBy == request.resource.data.distributorId;
      allow update, delete: if false;
    }

    match /perDiems/{perDiemId} {
      allow read: if isAdmin()
        || hasPermission('viewOtherDecont')
        || isTeamMember(resource.data.teamId)
        || (isActive() && (resource.data.memberId == request.auth.uid
          || resource.data.distributedBy == request.auth.uid));
      allow create: if isAdmin()
        || (hasPermission('viewOwnDecont') && isTeamMember(request.resource.data.teamId)
          && request.resource.data.distributedBy == request.auth.uid);
      allow update: if isAdmin()
        || (isActive() && resource.data.memberId == request.auth.uid
          && resource.data.distributedBy is string
          && resource.data.distributedBy != request.auth.uid
          && resource.data.status == 'awaitingConfirmation'
          && resource.data.get('actualReceivedAmount', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','received','actualReceivedAmount','confirmedAt','receiptUpdatedAt'
          ])
          && (
            (request.resource.data.status == 'awaitingConfirmation'
              && request.resource.data.received == false
              && request.resource.data.actualReceivedAmount == null)
            ||
            (request.resource.data.status == 'confirmed'
              && request.resource.data.received == true
              && request.resource.data.actualReceivedAmount is number
              && request.resource.data.actualReceivedAmount > 0)
          ));
      allow delete: if isAdmin();
    }

    match /finance/{teamId} {
      allow read: if isAdmin()
        || hasPermission('viewOtherDecont')
        || isTeamMember(teamId);
      allow create, update: if isAdmin()
        || (hasPermission('viewOwnDecont') && isTeamMember(teamId));
      allow delete: if isAdmin();
    }

    match /settlements/{settlementId} {
      allow read: if isAdmin()
        || hasPermission('viewOtherDecont')
        || isTeamMember(resource.data.teamId);
      allow create: if isAdmin()
        || (hasPermission('viewOwnDecont') && isTeamMember(request.resource.data.teamId));
      allow update: if isAdmin()
        || (hasPermission('viewOwnDecont')
          && isTeamMember(resource.data.teamId)
          && isTeamMember(request.resource.data.teamId));
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isActive() && resource.data.userId == request.auth.uid);

      allow create: if isActive()
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'message', 'createdAt', 'read', 'updatedAt'
        ])
        && request.resource.data.userId is string
        && canNotifyUser(request.resource.data.userId)
        && request.resource.data.read == false;

      allow update: if isAdmin()
        || (isActive()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /chatMessages/{messageId} {
      // Interogările clientului sunt intenționat pe senderId/recipientId; astfel
      // Firestore poate demonstra dreptul de citire fără a respinge query-ul.
      allow read: if isActive()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);

      allow create: if isActive()
        && request.resource.data.keys().hasOnly([
          'chatId', 'senderId', 'senderName', 'recipientId', 'recipientName', 'participantIds',
          'text', 'customEmoji', 'createdAt', 'read', 'updatedAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.recipientId in request.resource.data.participantIds
        && exists(otherUserPath(request.resource.data.recipientId))
        && get(otherUserPath(request.resource.data.recipientId)).data.active == true
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000
        && request.resource.data.read == false;

      allow update: if isActive()
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.participantIds == resource.data.participantIds
        && (
          (resource.data.recipientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'read', 'readAt', 'updatedAt'
            ]))
          ||
          (request.auth.uid in resource.data.participantIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deletedFor', 'updatedAt'
            ])
            && request.resource.data.deletedFor is list
            && request.auth.uid in request.resource.data.deletedFor)
        );

      // Mesajele nu sunt șterse global de un participant. „Șterge conversația”
      // adaugă utilizatorul în deletedFor și păstrează istoricul celuilalt membru.
      allow delete: if false;
    }

    match /groupChatMessages/{messageId} {
      // Chatul comun este vizibil tuturor conturilor active. Mesajele sunt păstrate
      // scurt și clientul încarcă doar ultimele 50 pentru a reduce citirile.
      allow read: if isActive();

      allow create: if isActive()
        && request.resource.data.keys().hasOnly([
          'senderId', 'senderName', 'senderPhotoBase64', 'text', 'customEmoji', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderPhotoBase64 is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000
        && request.resource.data.createdAt is timestamp;

      allow update: if false;

      // Orice membru activ poate participa la curățarea automată, dar numai pentru
      // mesaje mai vechi de 7 zile; mesajele recente nu pot fi șterse global din client.
      allow delete: if isActive()
        && resource.data.createdAt is timestamp
        && resource.data.createdAt < request.time - duration.value(7, 'd');
    }

    match /users/{userId}/pushTokens/{tokenId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /documents/{documentId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /meta/{documentId} {
      allow read: if documentId == 'uiSettings' || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (documentId == 'uiSettings'
          && hasPermission('manageMessageTemplates')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'smsTemplates', 'updatedAt'
          ]));
    }

    // Poziții live interne. Utilizatorul își scrie doar propria poziție;
    // membrii activi pot vedea pozițiile colegilor din aplicația internă.
    match /liveLocations/{userId} {
      allow read: if isActive();
      allow create, update: if isAdmin() || (isActive() && request.auth.uid == userId);
      allow delete: if isAdmin() || (isActive() && request.auth.uid == userId);
    }

    match /errorReports/{reportId} {
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isActive() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /suggestions/{suggestionId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upVotes', 'downVotes']));
      allow delete: if isAdmin() || (isActive() && resource.data.userId == request.auth.uid);
    }

    match /updateHistory/{entryId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Jurnal structurat folosit de Learning. Membrii activi pot adăuga evenimente
    // proprii și pot citi istoricul necesar rutării; doar Admin poate modifica/șterge.
    match /learningEvents/{eventId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Snapshot-uri interne de siguranță. Sunt disponibile exclusiv Adminului.
    match /backups/{backupId} {
      allow read, write: if isAdmin();
      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
