rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
 // XI_BEGIN
 function h_user(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
 function h_active(){return request.auth!=null && h_user().active==true;}
 function h_actor(team){
  return h_active() && (h_user().role=='admin' ||
    (h_user().role!='director' && h_user().get('function','')!='director' && !('director' in h_user().get('functionIds',[])) && 'viewOwnDecont' in h_user().effectivePermissions &&
      request.auth.uid in get(/databases/$(database)/documents/teams/$(team)).data.members &&
      get(/databases/$(database)/documents/teams/$(team)).data.financialManagerId==request.auth.uid));
 }
 function h_read(team){
  return h_active() && (h_user().role=='admin' ||
    'viewOtherDecont' in h_user().effectivePermissions ||
    request.auth.uid in get(/databases/$(database)/documents/teams/$(team)).data.members);
 }
 function h_money(x){return x is number && x>=0 && x-x==0;}
 function h_summary(id){return /databases/$(database)/documents/financeHistoryXi/$(id);}
 function h_before(id){return exists(h_summary(id))?get(h_summary(id)).data:{};}
 function h_shape(id,d){
  return d.keys().hasOnly(['protocol','teamId','sourceCollection','sourceId','revision','receivedDeparture','receivedDuring','lastOperationId','updatedAt'])
   && d.keys().hasAll(['protocol','teamId','sourceCollection','sourceId','revision','receivedDeparture','receivedDuring','lastOperationId','updatedAt'])
   && d.protocol==2 && d.teamId is string && d.teamId.size()>0
   && d.sourceCollection in ['finance','settlements'] && d.sourceId is string
   && id==(d.sourceCollection=='finance'?'f_':'s_')+d.sourceId
   && (d.sourceCollection!='finance' || d.sourceId==d.teamId)
   && d.revision is int && d.revision>0 && d.revision<=9007199254740991
   && d.lastOperationId is string && d.lastOperationId.matches('^[a-f0-9]{32}$')
   && h_money(d.receivedDeparture) && h_money(d.receivedDuring) && d.updatedAt==request.time;
 }
 function h_row(r,op,d,base){
  return r.keys().hasOnly(['protocol','operationId','digest','actorUid','teamId','targetPath','baseRevision','revision','kind','amount','method','fromName','date','createdAt'])
   && r.keys().hasAll(['protocol','operationId','digest','actorUid','teamId','targetPath','baseRevision','revision','kind','amount','method','fromName','date','createdAt'])
   && r.protocol==2 && r.operationId==op && op.matches('^[a-f0-9]{32}$')
   && r.digest is string && r.digest.matches('^[a-f0-9]{64}$')
   && r.actorUid==request.auth.uid && r.teamId==d.teamId && r.targetPath==d.sourceCollection+'/'+d.sourceId
   && r.baseRevision==base && r.revision==base+1 && r.kind in ['departure','during']
   && h_money(r.amount) && r.amount>0 && r.method in ['Cash','Transfer']
   && r.fromName is string && r.fromName.size()>0 && r.date is map
   && r.date.keys().hasOnly(['seconds','nanoseconds']) && r.date.keys().hasAll(['seconds','nanoseconds'])
   && r.date.seconds is int && r.date.seconds>=-62135596800 && r.date.seconds<=253402300799
   && r.date.nanoseconds is int && r.date.nanoseconds>=0 && r.date.nanoseconds<=999999999
   && r.createdAt==request.time;
 }
 function h_source_actor(d){
  let source=get(/databases/$(database)/documents/$(d.sourceCollection)/$(d.sourceId)).data;
  let manager=source.get('managerId',get(/databases/$(database)/documents/teams/$(d.teamId)).data.financialManagerId);
  return source.teamId==d.teamId && source.get('closed',false)==false &&
   (h_user().role=='admin' || manager==request.auth.uid);
 }
 function h_empty_source(d){
  let source=get(/databases/$(database)/documents/$(d.sourceCollection)/$(d.sourceId)).data;
  return source.teamId==d.teamId && source.get('closed',false)==false
   && source.get('revision',0)==0 && source.get('receivedDeparture',0)==0 && source.get('receivedDuring',0)==0
   && source.get('receivedOpeningDeparture',0)==0 && source.get('receivedOpeningDuring',0)==0
   && source.get('receivedEntries',[])==[];
 }
 function h_transition(id,d,b,r){
  let base=b.get('revision',0);
  let departure=b.get('receivedDeparture',0);
  let during=b.get('receivedDuring',0);
  return h_shape(id,d) && h_actor(d.teamId) && h_source_actor(d) && base is int && base>=0 && base<9007199254740991
   && d.revision==base+1 && h_row(r,d.lastOperationId,d,base)
   && (!exists(h_summary(id))?h_empty_source(d):
     (b.teamId==d.teamId && b.sourceCollection==d.sourceCollection && b.sourceId==d.sourceId && b.protocol==2))
   && d.receivedDeparture==departure+(r.kind=='departure'?r.amount:0)
   && d.receivedDuring==during+(r.kind=='during'?r.amount:0)
   && (r.kind=='departure'?d.receivedDeparture>departure:d.receivedDuring>during);
 }
 match /financeHistoryXi/{id} {
  allow get: if (exists(h_summary(id))?h_read(resource.data.teamId):h_active());
  allow list: if false;
  allow create,update: if
   !exists(/databases/$(database)/documents/financeHistoryXi/$(id)/receipts/$(request.resource.data.lastOperationId))
   && h_transition(id,request.resource.data,h_before(id),getAfter(/databases/$(database)/documents/financeHistoryXi/$(id)/receipts/$(request.resource.data.lastOperationId)).data);
  allow delete: if false;
  match /receipts/{op} {
   allow get: if exists(h_summary(id))?h_read(get(h_summary(id)).data.teamId):
    (!exists(/databases/$(database)/documents/financeHistoryXi/$(id)/receipts/$(op)) && h_active());
   allow list: if request.query.limit!=null && request.query.limit<=20 && h_read(get(h_summary(id)).data.teamId);
   allow create: if h_transition(id,getAfter(h_summary(id)).data,h_before(id),request.resource.data)
    && getAfter(h_summary(id)).data.lastOperationId==op;
   allow update,delete: if false;
  }
 }
 // XI_END
 match /users/{id} {allow read:if request.auth!=null && request.auth.uid==id;}
 match /teams/{id} {allow read:if h_active();}
 match /{collection}/{id} {
  allow read:if collection in ['finance','settlements'] && h_read(resource.data.teamId);
 }
 }
}
