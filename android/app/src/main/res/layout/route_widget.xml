<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#202832">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Andi Carpet · Traseu" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/route_prev_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" ◀ Zi " android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/route_day" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Nesincronizat" android:textColor="#FFFFFF" android:gravity="center"/>
        <TextView android:id="@+id/route_next_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Zi ▶ " android:textColor="#FFFFFF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/route_stop_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF"/><TextView android:id="@+id/route_maps_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#81D4FA"/><TextView android:id="@+id/route_waze_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:textColor="#81D4FA"/></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/route_stop_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF"/><TextView android:id="@+id/route_maps_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#81D4FA"/><TextView android:id="@+id/route_waze_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:textColor="#81D4FA"/></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/route_stop_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF"/><TextView android:id="@+id/route_maps_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#81D4FA"/><TextView android:id="@+id/route_waze_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:textColor="#81D4FA"/></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/route_prev_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="◀ Locații" android:textColor="#FFFFFF"/><TextView android:id="@+id/route_next_page" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locații ▶" android:textColor="#FFFFFF"/></LinearLayout>
</LinearLayout>
